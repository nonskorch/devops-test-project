# Образ с Node 24, вариант alpine — облегчённый, меньше пакетов внутри и меньше весит
FROM node:24-alpine
# Рабочая папка внутри контейнера
WORKDIR /app
#  Копируем манифесты отдельно от кода, чтобы зависимости не переустанавливались при каждой правке
COPY package*.json ./
# npm ci ставит строго те версии, что записаны в package-lock.json, сборка
# воспроизводима — на любой машине и в любой момент соберётся то же самое.
RUN npm ci
# Копируем код и собираем, что сюда НЕ попадёт — перечислено в .dockerignore
COPY . .
# Сборка — команда из задания
RUN npm run build
# Приложение слушает порт 3000 (посмотрел в src/main.ts)
# EXPOSE только документирует порт, наружу его не публикует 
EXPOSE 3000
# Запуск как указано в задании
CMD ["npm", "start"]